generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(active)
  lastLogin    DateTime?  @map("last_login")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  studentProfiles StudentProfile[]
  vendor          Vendor?
  schoolAdmin     SchoolAdmin?
  notifications   Notification[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

enum UserRole {
  parent
  vendor
  school_admin
  platform_admin
}

enum UserStatus {
  active
  inactive
  suspended
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model StudentProfile {
  id                 String   @id @default(uuid())
  universalStudentId String   @unique @map("universal_student_id")
  userId             String   @map("user_id")
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  dateOfBirth        DateTime @map("date_of_birth")
  gender             Gender
  bloodGroup         String?  @map("blood_group")
  address            String
  city               String
  state              String
  parentName         String   @map("parent_name")
  parentPhone        String   @map("parent_phone")
  parentEmail        String   @map("parent_email")
  profilePictureUrl  String?  @map("profile_picture_url")
  qrCodeUrl          String?  @map("qr_code_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  documents    Document[]
  tickets      InterviewTicket[]
  gamification ParentGamification?

  @@map("student_profiles")
}

enum Gender {
  male
  female
  other
}

model School {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  boardType      BoardType    @map("board_type")
  address        String
  city           String
  state          String
  phone          String
  email          String
  website        String?
  description    String?
  feesMin        Int          @map("fees_min")
  feesMax        Int          @map("fees_max")
  capacity       Int
  availableSeats Int          @map("available_seats")
  facilities     String[]
  rating         Float        @default(0)
  alumniCount    Int          @default(0) @map("alumni_count")
  foundedYear    Int?         @map("founded_year")
  demandLevel    DemandLevel  @map("demand_level")
  logoUrl        String?      @map("logo_url")
  status         SchoolStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  admins       SchoolAdmin[]
  formCatalog  FormCatalogItem[]
  applications Application[]
  tickets      InterviewTicket[]
  transactions Transaction[]
  pricingRules SchoolPricingRule[]

  @@map("schools")
}

enum BoardType {
  CBSE
  ICSE
  IB
  State
}

enum DemandLevel {
  low
  medium
  high
  critical
}

enum SchoolStatus {
  active
  inactive
  pending
}

model SchoolAdmin {
  id       String @id @default(uuid())
  userId   String @unique @map("user_id")
  schoolId String @map("school_id")
  position String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_admins")
}

model Vendor {
  id                  String       @id @default(uuid())
  userId              String       @unique @map("user_id")
  vendorId            String       @unique @map("vendor_id")
  name                String
  businessName        String?      @map("business_name")
  address             String
  city                String
  status              VendorStatus @default(active)
  tokenBalance        Int          @default(0) @map("token_balance")
  maxTokenBalance     Int          @default(5000) @map("max_token_balance")
  totalCollections    Int          @default(0) @map("total_collections")
  totalTicketsPrinted Int          @default(0) @map("total_tickets_printed")
  performanceScore    Float        @default(100) @map("performance_score")
  commissionRate      Float        @default(0.20) @map("commission_rate")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]      @relation("VendorApplications")
  settlements  VendorSettlement[]

  @@map("vendors")
}

enum VendorStatus {
  active
  inactive
  suspended
}

model FormCatalogItem {
  id               String        @id @default(uuid())
  schoolId         String        @map("school_id")
  formType         FormType      @map("form_type")
  formName         String        @map("form_name")
  basePrice        Int           @map("base_price")
  currency         String        @default("TZS")
  taxPercentage    Float         @default(0) @map("tax_percentage")
  isActive         Boolean       @default(true) @map("is_active")
  schoolCommission Float         @default(0.80) @map("school_commission")
  description      String?
  createdAt        DateTime      @default(now()) @map("created_at")
  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@map("form_catalog")
}

enum FormType {
  admission
  transfer
  scholarship
  exam
}

model Application {
  id                     String            @id @default(uuid())
  submissionId           String            @unique @map("submission_id")
  studentProfileId       String            @map("student_profile_id")
  schoolId               String            @map("school_id")
  formCatalogItemId      String?           @map("form_catalog_item_id")
  formType               FormType          @map("form_type")
  status                 ApplicationStatus
  totalAmount            Int               @map("total_amount")
  baseAmount             Int               @map("base_amount")
  surgeAmount            Int               @default(0) @map("surge_amount")
  discountAmount         Int               @default(0) @map("discount_amount")
  taxAmount              Int               @default(0) @map("tax_amount")
  paymentStatus          PaymentStatus     @map("payment_status")
  assignedVendorId       String?           @map("assigned_vendor_id")
  vendorPaymentConfirmed Boolean           @default(false) @map("vendor_payment_confirmed")
  vendorConfirmedAt      DateTime?         @map("vendor_confirmed_at")
  paymentMethod          String?           @map("payment_method")
  paymentReference       String?           @map("payment_reference")
  cashTendered           Int?              @map("cash_tendered")
  changeReturned         Int?              @map("change_returned")
  vendorNotes            String?           @map("vendor_notes")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  studentProfile StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vendor         Vendor?           @relation("VendorApplications", fields: [assignedVendorId], references: [id])
  tickets        InterviewTicket[]
  transactions   Transaction[]

  @@map("applications")
}

enum ApplicationStatus {
  draft
  submitted
  payment_pending
  paid
  tickets_generated
  interview_scheduled
  accepted
  rejected
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model InterviewTicket {
  id               String       @id @default(uuid())
  ticketNumber     String       @unique @map("ticket_number")
  applicationId    String       @map("application_id")
  studentProfileId String       @map("student_profile_id")
  schoolId         String       @map("school_id")
  interviewDate    DateTime     @map("interview_date")
  interviewTime    String       @map("interview_time")
  venue            String
  room             String?
  instructions     String?
  ticketQrCode     String?      @map("ticket_qr_code")
  status           TicketStatus @default(valid)
  printedByVendor  Boolean      @default(false) @map("printed_by_vendor")
  printedAt        DateTime?    @map("printed_at")
  printCount       Int          @default(0) @map("print_count")
  createdAt        DateTime     @default(now()) @map("created_at")

  application    Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("interview_tickets")
}

enum TicketStatus {
  valid
  used
  expired
  cancelled
}

model Document {
  id                   String                     @id @default(uuid())
  studentProfileId     String                     @map("student_profile_id")
  documentType         DocumentType               @map("document_type")
  fileName             String                     @map("file_name")
  fileUrl              String                     @map("file_url")
  fileSize             Int                        @map("file_size")
  mimeType             String                     @map("mime_type")
  uploadDate           DateTime                   @default(now()) @map("upload_date")
  verificationStatus   DocumentVerificationStatus @map("verification_status")
  aiConfidenceScore    Float?                     @map("ai_confidence_score")
  blockchainHash       String?                    @map("blockchain_hash")
  blockchainAnchoredAt DateTime?                  @map("blockchain_anchored_at")
  verificationNotes    String?                    @map("verification_notes")
  createdAt            DateTime                   @default(now()) @map("created_at")
  studentProfile       StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("documents")
}

enum DocumentType {
  birth_certificate
  previous_marksheet
  transfer_letter
  medical_record
  id_proof
  photo
}

enum DocumentVerificationStatus {
  pending
  verified
  blockchain_anchored
  rejected
}

model Transaction {
  id                 String        @id @default(uuid())
  transactionId      String        @unique @map("transaction_id")
  applicationId      String        @map("application_id")
  formCatalogItemId  String?       @map("form_catalog_item_id")
  schoolId           String        @map("school_id")
  baseAmount         Int           @map("base_amount")
  discountApplied    Int           @default(0) @map("discount_applied")
  taxAmount          Int           @default(0) @map("tax_amount")
  totalAmount        Int           @map("total_amount")
  platformCommission Float         @map("platform_commission")
  schoolRevenue      Float         @map("school_revenue")
  paymentMethod      String        @map("payment_method")
  paymentStatus      PaymentStatus @map("payment_status")
  vendorId           String?       @map("vendor_id")
  processedBy        String?       @map("processed_by")
  createdAt          DateTime      @default(now()) @map("created_at")

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  formCatalog FormCatalogItem? @relation(fields: [formCatalogItemId], references: [id])
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model VendorSettlement {
  id                   String           @id @default(uuid())
  vendorId             String           @map("vendor_id")
  settlementPeriod     String           @map("settlement_period")
  totalFormsProcessed  Int              @map("total_forms_processed")
  totalRevenue         Int              @map("total_revenue")
  platformCommission   Float            @map("platform_commission")
  vendorPayout         Float            @map("vendor_payout")
  status               SettlementStatus
  paidAt               DateTime?        @map("paid_at")
  transactionReference String?          @map("transaction_reference")
  createdAt            DateTime         @default(now()) @map("created_at")
  vendor               Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_settlements")
}

enum SettlementStatus {
  pending
  processed
  paid
  failed
}

model SchoolPricingRule {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  ruleType   String   @map("rule_type")
  condition  Json?    @map("condition")
  adjustment Float    @map("adjustment")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_pricing_rules")
}

model AcademicYear {
  id        String   @id @default(uuid())
  year      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(false) @map("is_active")
  terms     Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("academic_years")
}

model GradingScale {
  id          String  @id @default(uuid())
  grade       String
  minMarks    Int     @map("min_marks")
  maxMarks    Int     @map("max_marks")
  description String
  color       String
  points      Float
  isActive    Boolean @default(true) @map("is_active")
  order       Int

  @@map("grading_scales")
}

model Notification {
  id        String                 @id @default(uuid())
  userId    String                 @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json?
  status    NotificationReadStatus @default(unread)
  createdAt DateTime               @default(now()) @map("created_at")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  application_submitted
  payment_confirmed
  ticket_generated
  interview_scheduled
  document_verified
  blockchain_anchored
  vendor_assigned
  system_alert
  emergency_protocol
}

enum NotificationReadStatus {
  unread
  read
  archived
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model EmergencyProtocol {
  id            String    @id @default(uuid())
  type          String
  name          String
  description   String
  adjustments   Json      @map("adjustments")
  isActive      Boolean   @default(false) @map("is_active")
  activatedAt   DateTime? @map("activated_at")
  activatedBy   String?   @map("activated_by")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("emergency_protocols")
}

model ParentGamification {
  id                String         @id @default(uuid())
  studentProfileId  String         @unique @map("student_profile_id")
  totalXP           Int            @default(0) @map("total_xp")
  currentRank       Int            @default(0) @map("current_rank")
  badges            Json?
  perksUnlocked     String[]       @map("perks_unlocked")
  nextBadgeProgress Float          @default(0) @map("next_badge_progress")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("parent_gamification")
}
